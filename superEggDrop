class Solution {
    public int superEggDrop(int k, int n) {
        int[][] dp = new int[n+1][k+1]; // attempts, eggs
        int attempts = 0;
        while(dp[attempts][k] < n) {
            attempts++;
            for(int j=1; j<k+1; j++) {
                dp[attempts][j] = 1 + dp[attempts - 1][j - 1] + dp[attempts - 1][j];
            }
        }
        return attempts;
    }
}